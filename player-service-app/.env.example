# Reference only: the application does not automatically load this file.
PLAYER_INTEGRATION_ENABLED=false

# Required when enabled. Supply a secret-manager value generated from at least
# 32 random bytes (for example, Python secrets.token_urlsafe(32)); never commit it.
PLAYER_INTEGRATION_TOKEN=

# Integration-only SQLite limits in seconds; legacy defaults are unchanged.
PLAYER_DB_BUSY_TIMEOUT_SECONDS=1
PLAYER_QUERY_TIMEOUT_SECONDS=2

# Metrics share the integration token. Keep /integrations/express/v1/metrics
# private; use one worker process (threads supported) per scrape target.
# Leave PROMETHEUS_MULTIPROC_DIR and prometheus_multiproc_dir UNSET, not empty.
